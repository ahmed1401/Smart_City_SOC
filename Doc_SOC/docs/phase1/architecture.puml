@startuml Architecture
scale 1.0
skinparam componentStyle rectangle

actor Citizen
actor Operator

component "Web Client\n(React)" as WebClient
component "API Gateway\n(Kong)" as Gateway
component "SmartFlow\nOrchestrator" as SmartFlow
component "Mobility REST\nSpring Boot" as Mobility
component "AirQuality SOAP\nJAX-WS" as AirQuality
component "Emergency gRPC\nGo" as Emergency
component "Directory GraphQL\nApollo" as Directory
component "Observability Stack\n(Prometheus/Grafana/Loki)" as Observability

node "Data Stores" {
  database "PostgreSQL\nMobility" as PgMob
  database "Legacy AQI DB" as AqiDb
  database "Redis Streams" as Redis
  database "PostgreSQL\nDirectory" as PgDir
  database "PostgreSQL\nKong Config" as PgKong
}

Citizen --> WebClient
Operator --> WebClient
WebClient --> Gateway
Gateway --> SmartFlow : /api/smartflow
Gateway --> Mobility : /api/mobility
Gateway --> AirQuality : SOAP endpoint
Gateway --> Emergency : gRPC proxy (Envoy)
Gateway --> Directory : /api/directory

SmartFlow --> Mobility
SmartFlow --> AirQuality

Mobility --> PgMob
AirQuality --> AqiDb
Emergency --> Redis
Directory --> PgDir
Gateway --> PgKong

SmartFlow --> Observability
Mobility --> Observability
AirQuality --> Observability
Emergency --> Observability
Directory --> Observability

@enduml
